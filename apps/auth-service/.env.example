PORT=4020
DATABASE_URL=postgres://postgres:postgres@localhost:5433/user_service
LOG_LEVEL=debug

RABBITMQ_URL=amqp://breezy:breezy@localhost:5672
REDIS_URL=redis://localhost:6379

APP_URL=http://localhost:3000

# RS256 keypair — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# RECOMMENDED: point to the .pem files (avoids .env encoding issues)
JWT_PRIVATE_KEY_PATH=./private.pem
JWT_PUBLIC_KEY_PATH=./public.pem
JWT_KID=key-1

# ALTERNATIVE: inline PEM — must be single-line with \n escaping:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# Pending (2FA) token secret — HS256, internal to auth-service only
JWT_SECRET=your_pending_token_secret

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_MS=604800000

LOG_FILE=./logs/auth-service.log

PROFILE_SERVICE_GRPC_URL=localhost:50051
