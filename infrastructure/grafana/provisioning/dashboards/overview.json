              { "color": "yellow", "value": 134217728 },
              { "color": "red", "value": 268435456 }
            ]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["Time", "used_memory"] } }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "redis-datasource", "uid": "redis" },
          "refId": "A",
          "command": "info",
          "section": "memory",
          "type": "timeseries",
          "streaming": true,
          "streamingInterval": 15000,
          "streamingCapacity": 100
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Hit Rate",
      "id": 33,
      "gridPos": { "x": 9, "y": 24, "w": 5, "h": 6 },
      "datasource": { "type": "redis-datasource", "uid": "redis" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "/^hit_rate$/" },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "custom": {}
        }
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": { "include": { "names": ["Time", "keyspace_hits", "keyspace_misses"] } }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binaryOperation",
            "alias": "hit_rate",
            "binary": {
              "left": "keyspace_hits",
              "operator": "/",
              "right": {
                "id": "calculateField",
                "options": {
                  "mode": "binaryOperation",
                  "binary": { "left": "keyspace_hits", "operator": "+", "right": "keyspace_misses" }
                }
              }
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binaryOperation",
            "alias": "hit_rate",
            "binary": { "left": "hit_rate", "operator": "*", "right": "100" }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "redis-datasource", "uid": "redis" },
          "refId": "A",
          "command": "info",
          "section": "stats",
          "type": "timeseries"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commands/sec",
