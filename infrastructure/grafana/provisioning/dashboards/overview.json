    {
      "type": "timeseries",
      "title": "Latency Percentiles by Service",
      "id": 13,
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
