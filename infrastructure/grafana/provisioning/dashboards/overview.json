    {
      "type": "timeseries",
      "title": "Memory Usage",
      "id": 32,
      "gridPos": { "x": 4, "y": 24, "w": 5, "h": 6 },
      "datasource": { "type": "redis-datasource", "uid": "redis" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineInterpolation": "smooth", "gradientMode": "scheme" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
