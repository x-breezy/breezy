    {
      "type": "stat",
      "title": "Services Up",
      "id": 2,
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "custom": {}
        }
      },
      "targets": [
        {
          "expr": "up{job=~\"auth-service|profile-service|post-service|media-service|notifications-service|message-service\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Overall Request Rate",
      "id": 3,
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
